# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instant_delivery
DB_USER=postgres
DB_PASSWORD=your_password_here

# Firebase Admin SDK (from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="your-private-key-here"
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com

# Frontend URLs allowed to call this backend (comma separated, no spaces)
# Add your customer website, delivery partner web/app, and admin dashboard URLs here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Cloudinary (Product Images)
# From: https://cloudinary.com/console -> Dashboard (after free signup)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (Payments)
# From: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From: Settings -> Webhooks (after you create a webhook pointing to /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
